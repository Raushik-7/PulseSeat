# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulseseat?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pulseseat?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Supabase (use local PostgreSQL for dev when Supabase is not available)
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# JWT / Auth
JWT_SECRET="dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Backend API
API_PORT=3001
API_HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="info"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_GENERAL=100
RATE_LIMIT_BOOKING=10
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW_MS=60000

# Booking
BOOKING_HOLD_DURATION_MS=900000
BOOKING_IDEMPOTENCY_EXPIRY_S=3600

# Payment
PAYMENT_PROVIDER="mock"
PAYMENT_SECRET=""

# Queue
QUEUE_CONCURRENCY=5
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=2000

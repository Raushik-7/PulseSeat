# ─────────────────────────────────────────────────────────────────────────────
# PulseSeat — Environment Configuration Template
# Copy to .env (root, used by API + Prisma) and/or Vercel project settings (web).
# NEVER commit real secrets. Generate strong values where noted.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local dev (Docker compose maps host port 5433):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pulseseat?schema=public"
# Direct (non-pooled) connection for migrations — same as DATABASE_URL locally,
# but MUST be the direct URL on pooled providers (Supabase/Neon):
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/pulseseat?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local: docker compose up -d redis. Production: managed Redis TLS URL (rediss://)
REDIS_URL="redis://localhost:6379"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48   (NEVER use the dev value in production)
JWT_SECRET="dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# ─── API server ───────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── URLs ─────────────────────────────────────────────────────────────────────
# API base URL the browser talks to (also used by the web app at build time)
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Frontend base URL — used in verification / password-reset email links AND as
# an automatic CORS origin. In production set this to your real https URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Extra allowed CORS origins, comma-separated (optional — NEXT_PUBLIC_APP_URL
# and any *.vercel.app origin are always allowed):
# CORS_ORIGINS="https://pulseseat.example.com,https://pulseseat.vercel.app"

# ─── Rate limiting (requests per window) ──────────────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_BOOKING=10
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW_MS=60000

# ─── Booking ──────────────────────────────────────────────────────────────────
BOOKING_HOLD_DURATION_MS=900000
BOOKING_IDEMPOTENCY_EXPIRY_S=3600

# ─── Payments ─────────────────────────────────────────────────────────────────
# mock  = dev/test, auto-confirm, no external calls
# stripe = real Payment Intents (requires PAYMENT_SECRET)
PAYMENT_PROVIDER="mock"
PAYMENT_SECRET=""                 # Stripe secret key (sk_test_... / sk_live_...)
STRIPE_WEBHOOK_SECRET=""          # whsec_... from the Stripe webhook endpoint

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave empty in dev → emails are logged to the API console instead of sent.
# Production: real SMTP (Resend / Postmark / SES / Mailgun).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PulseSeat <noreply@pulseseat.dev>"

# ─── Background jobs (BullMQ) ─────────────────────────────────────────────────
QUEUE_CONCURRENCY=5
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=2000

# ─── Frontend-only flags ──────────────────────────────────────────────────────
NEXT_PUBLIC_SHOW_ERROR_OVERLAY=false

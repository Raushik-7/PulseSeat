// PulseSeat Database Schema
// PostgreSQL with Supabase — designed for concurrency-safe ticket booking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
  COMPLETED
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
  DISABLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProviderType {
  STRIPE
  RAZORPAY
  MOCK
}

// ─── Tables ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bookings   Booking[]
  auditLogs  AuditLog[]
  idempotencyKeys IdempotencyKey[] @relation("IdempotencyUser")

  @@map("users")
}

model Event {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  category    String
  venue       String
  city        String
  eventDate   DateTime    @map("event_date")
  startTime   String      @map("start_time")
  endTime     String      @map("end_time")
  bannerUrl   String?     @map("banner_url")
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  seats    Seat[]
  bookings Booking[]

  @@index([status])
  @@index([eventDate])
  @@index([city])
  @@index([category])
  @@map("events")
}

model Seat {
  id         String     @id @default(cuid())
  eventId    String     @map("event_id")
  seatNumber String     @map("seat_number")
  row        String
  section    String
  price      Decimal    @db.Decimal(10, 2)
  status     SeatStatus @default(AVAILABLE)
  bookedBy   String?    @map("booked_by")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@unique([eventId, seatNumber])
  @@index([eventId])
  @@index([eventId, status])
  @@index([eventId, row])
  @@map("seats")
}

model Booking {
  id                String         @id @default(cuid())
  userId            String         @map("user_id")
  eventId           String         @map("event_id")
  bookingReference  String         @unique @map("booking_reference")
  status            BookingStatus  @default(PENDING)
  totalAmount       Decimal        @db.Decimal(10, 2) @map("total_amount")
  paymentStatus     PaymentStatus  @default(PENDING) @map("payment_status")
  holdExpiresAt     DateTime?      @map("hold_expires_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id])
  bookingItems  BookingItem[]
  payments      Payment[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([bookingReference])
  @@map("bookings")
}

model BookingItem {
  id         String   @id @default(cuid())
  bookingId  String   @map("booking_id")
  seatId     String   @map("seat_id")
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id])

  @@index([bookingId])
  @@index([seatId])
  @@map("booking_items")
}

model Payment {
  id                String              @id @default(cuid())
  bookingId         String              @map("booking_id")
  provider          PaymentProviderType @default(MOCK)
  providerPaymentId String?             @unique @map("provider_payment_id")
  amount            Decimal             @db.Decimal(10, 2)
  currency          String              @default("INR")
  status            PaymentStatus       @default(PENDING)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

model IdempotencyKey {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  key           String   @unique
  requestHash   String   @map("request_hash")
  responseStatus Int     @map("response_status")
  responseBody  Json     @map("response_body")
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")

  user User? @relation("IdempotencyUser", fields: [userId], references: [id])

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

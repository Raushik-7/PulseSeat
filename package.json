{
  "name": "pulseseat",
  "version": "1.0.0",
  "private": true,
  "description": "PulseSeat — High-Throughput Ticket Booking Engine",
  "scripts": {
    "dev": "concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter api test",
    "test:unit": "pnpm --filter api test:unit",
    "test:integration": "pnpm --filter api test:integration",
    "test:concurrency": "pnpm --filter api test:concurrency",
    "db:generate": "pnpm --filter @pulseseat/prisma generate",
    "db:migrate": "pnpm --filter @pulseseat/prisma migrate",
    "db:seed": "pnpm --filter @pulseseat/prisma seed",
    "db:reset": "pnpm --filter @pulseseat/prisma migrate reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "load:test": "k6 run load-tests/booking-load-test.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
